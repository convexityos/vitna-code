{
  "name": "vitna-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Vitna Code desktop frontend: a run, its approvals and its receipt, drawn from the Vitna Agent Protocol. Runs in a browser for development; a desktop shell hosts it against vitna-coded.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "happy-dom": "^20.14.5",
    "typescript": "~5.6.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
